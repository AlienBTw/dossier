# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db
.vscode/
.idea/

# credentials & secrets
password*.txt
*password*.txt
*.secret
*.key
*.token
credentials.json

# local agent & AI rules
AGENTS.md

# local scratch & automation scripts
scratch/
scratch*
scripts/scratch_*
scripts/*.mts
scripts/*.cjs
scripts/*.sh
!scripts/hash-password.ts

# The website, built by site/build.sh
/_site/

# DOSSIER_DATA_DIR in development (backups, temporary downloads)
/data/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/src/generated/prisma-sqlite

# DOSSIER_DATA_DIR in development
/data

# end-to-end test runs
/e2e/.auth/
/playwright-report/
/test-results/

# The desktop app's dependencies and what it builds
/desktop/dist
/desktop/build-server
/desktop/build-input
/desktop/release
desktop/**/.yarn
desktop/**/node_modules
desktop/**/test-results
